{
  "module": "commonjs",
  "scripts": {
    "dev": "nodemon --watch 'src/**/*.ts' --exec ts-node --transpile-only src/server.ts",
    "migrate": "ts-node ./node_modules/typeorm/cli.js migration:generate -d ./data-source.ts src/migrations/Initial",
    "migrate:apply": "ts-node ./node_modules/typeorm/cli.js migration:run -d ./data-source.ts",
    "migrate:revert": "ts-node ./node_modules/typeorm/cli.js migration:revert -d ./data-source.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "dotenv": "^17.2.0",
    "fastify": "^5.4.0",
    "fastify-env": "^2.1.1",
    "fastify-jwt": "^4.1.3",
    "fastify-plugin": "^5.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@types/node": "^24.0.12",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
